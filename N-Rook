#include <iostream>
using namespace std;

int boardSize;
int rookBoard[20][20];

bool checkRook(int row, int col)
{
    for(int i = 0; i < row; i++)
    {
        if(rookBoard[i][col] == 1)
            return false;
    }

    return true;
}

void showBoard()
{
    for(int row = 0; row < boardSize; row++)
    {
        for(int col = 0; col < boardSize; col++)
        {
            if(rookBoard[row][col] == 1)
                cout << "R ";
            else
                cout << ". ";
        }
        cout << endl;
    }

    cout << endl;
}

void placeRooks(int row)
{
    if(row == boardSize)
    {
        showBoard();
        return;
    }

    for(int col = 0; col < boardSize; col++)
    {
        if(checkRook(row, col))
        {
            rookBoard[row][col] = 1;
            placeRooks(row + 1);
            rookBoard[row][col] = 0;
        }
    }
}

int main()
{
    cin >> boardSize;
    placeRooks(0);
    return 0;
}
